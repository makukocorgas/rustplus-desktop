<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.ConsoleHelperPopoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RustPlusDesk.Views"
                 Title="{DynamicResource ConsoleHelperTitle}"
                 Width="500" Height="760"
                 MinWidth="400" MinHeight="320"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Topmost="True"
                 ShowInTaskbar="True"
                 WindowStartupLocation="Manual">

    <!-- Without this, WindowStyle=None plus CanResize still lets Windows draw its glass frame,
         and a pale strip of it stays visible along the top edge. Zero caption height keeps the
         header clickable; the resize border stays so the window can still be sized. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Frameless, but not layered: AllowsTransparency stays off. A layered window is the worse
         host for popups and buys nothing here, since the panel fills its own rounded shell. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource ConsoleHelperTitle}" ShowMaximize="True" ShowMinimize="True" />

        <!-- Sits left of the caption buttons. Placed over the title bar rather than inside it,
             because this WPF-UI version has no slot for extra title bar content. -->
        <ui:Button x:Name="BtnPin" Grid.Row="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,142,0" Padding="8,4"
                   Appearance="Transparent"
                   Click="BtnPin_Click"
                   ToolTip="{DynamicResource ConsoleHelperKeepOnTop}"
                   Icon="{ui:SymbolIcon Symbol=Pin24}" />

        <views:ConsoleHelperOverlay x:Name="Helper" Grid.Row="1" Margin="6,0,6,6" />
    </Grid>
</ui:FluentWindow>
