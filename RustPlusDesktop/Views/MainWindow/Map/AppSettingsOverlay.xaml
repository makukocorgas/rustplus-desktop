<UserControl x:Class="RustPlusDesk.Views.AppSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RustPlusDesk.Converters"
             xmlns:p="clr-namespace:RustPlusDesk.Properties"
             xmlns:views="clr-namespace:RustPlusDesk.Views"
             xmlns:windows="clr-namespace:RustPlusDesk.Views.Windows"
             xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials"
             mc:Ignorable="d"
             Background="{DynamicResource Surface}"
             Foreground="{DynamicResource TextPrimary}"
             tutorials:Tutorial.TargetId="Settings.Panel">

    <Grid ClipToBounds="True">
        <Grid.Resources>
            <conv:NotNullToBoolConverter x:Key="LocalNotNull" />
            <Style x:Key="SettingsMenuItem" TargetType="ui:ListViewItem">
                <Setter Property="Margin" Value="12,0,12,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SettingsNativeCard" TargetType="ui:Card">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SettingsRowDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardBorder}" />
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>
            <Style x:Key="SettingsSubheader" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
                <ui:Button x:Name="BtnCloseSettings" Appearance="Transparent" Content="&#x2715;" Width="26" Height="26" Padding="0" FontSize="12" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnCloseSettings_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,10,12,8" Background="{DynamicResource SurfaceAlt}">
            <ui:TextBox x:Name="SettingsSearchBox" Height="34" ClearButtonEnabled="True" PlaceholderText="{DynamicResource UiSearchSettings}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource UiSearchSettings}" TextChanged="SettingsSearchBox_TextChanged">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="SettingsCategoryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,14,16,12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource UiChooseACategory}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiSettingsAreGroupedByWhatTheyControl}" />
                </StackPanel>
                <ui:ListView x:Name="SettingsCategoryList" Grid.Row="1" Padding="0,2,0,8" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsMenuItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsCategoryList_SelectionChanged">
                    <ui:ListViewItem Tag="general">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource General}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiLanguageStartupAndAppBehavior}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="alerts">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Alert24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource Alerts}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiNotificationsSoundsAndOfflineDeath}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="map">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiMap}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiPerformanceMarkersAnd3DData}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="connected">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ChatBubblesQuestion24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiConnectedServices}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiDiscordAndChat}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="chat-commands">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Chat24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource ChatCommandsSettings}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiConfigureTeamChatCommandsAndDeviceBindings}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="alert-templates">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Edit24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource CustomAlertsHeader}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource CustomAlertsDesc}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="system">
                        <Border Style="{StaticResource Card}" MinHeight="58" Padding="12,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowReset24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{DynamicResource UiSystem}" /><TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiMaintenanceBackupResetAndCredits}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ui:ListViewItem>
                </ui:ListView>
            </Grid>

            <Grid x:Name="SettingsDetailPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="10,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:Button Width="30" Height="30" Margin="0,0,10,0" Padding="0" Appearance="Transparent" ToolTip="{DynamicResource UiBackToSettingsCategories}" Click="SettingsBack_Click"><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsDetailTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="SettingsDetailSubtitle" Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:ListView x:Name="SettingsSectionList" Grid.Row="1" Margin="8" DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsSectionList_SelectionChanged" />

                <ScrollViewer x:Name="SettingsSearchResultsScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="SettingsSearchResults" Margin="12,12,12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button MinHeight="54" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Stretch" Appearance="Secondary" Tag="{Binding}" Click="SettingsSearchResult_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding BeforeMatch}" /><Run Background="#FF60CDFF" Foreground="#FF071218" FontWeight="Bold" Text="{Binding Match}" /><Run Text="{Binding AfterMatch}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextSubtle}"><Run Text="{Binding CategoryTitle}" /><Run Text="  &#8250;  " /><Run Text="{Binding SectionTitle}" /></TextBlock>
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsSectionsPanel" Margin="12">
                <!-- General Section -->
                <StackPanel x:Name="SectionGeneral">
                <TextBlock Text="{DynamicResource General}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Language -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource Language}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Select application display language" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" tutorials:Tutorial.TargetId="Settings.Language" Width="160" Height="32" SelectedValuePath="Code" SelectionChanged="CmbLanguage_SelectionChanged" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Settings24" Width="20" Height="15" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource TextSubtle}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <Image Source="{Binding ImagePath}" Width="20" Height="15" Margin="0,0,8,0" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Automatic Updates -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource AutomaticUpdates}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource AutomaticUpdatesToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoUpdate" AutomationProperties.Name="{DynamicResource AutomaticUpdates}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource AutomaticUpdatesToolTip}" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Launch With Windows -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource LaunchWithWindows}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Automatically start Rust+ Desktop when Windows starts" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoStart" AutomationProperties.Name="{DynamicResource LaunchWithWindows}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Start Minimized -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource StartMinimizedAlways}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Launch the application hidden in the system tray" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkStartMinimized" AutomationProperties.Name="{DynamicResource StartMinimizedAlways}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Auto Connect -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource AutoConnectLastServer}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource AutoConnectToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoConnect" AutomationProperties.Name="{DynamicResource AutoConnectLastServer}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource AutoConnectToolTip}" />
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Behavior Section -->
                <StackPanel x:Name="SectionBehavior">
                <TextBlock Text="{DynamicResource Behavior}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Group 1: Window & Interface -->
                        <ui:TextBlock Text="Window &amp; Interface" Style="{StaticResource SettingsSubheader}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource MinimizeToTray}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Keep the application running in the notification area when closed" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkCloseToTray" AutomationProperties.Name="{DynamicResource MinimizeToTray}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource HideSystemConsole}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource HideConsoleToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkHideConsole" AutomationProperties.Name="{DynamicResource HideSystemConsole}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource HideConsoleToolTip}" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Reduce UI Effects" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Turns off the Mica window backdrop — try this if the window reacts slowly. Requires restart." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkReduceUiEffects" AutomationProperties.Name="Reduce UI Effects" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="Turns off the Mica window backdrop, which is composed by Windows rather than by the app. Worth trying if the window reacts slowly to hovering or clicking. Requires a restart to take effect." />
                        </Grid>

                        <!-- Group 2: Privacy & Network -->
                        <Border Style="{StaticResource SettingsRowDivider}" Margin="0,14,0,10" />
                        <ui:TextBlock Text="Privacy &amp; Connectivity" Style="{StaticResource SettingsSubheader}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource EnableStreamerMode}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource StreamerModeToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkStreamerMode" AutomationProperties.Name="{DynamicResource EnableStreamerMode}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource StreamerModeToolTip}" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Network Traffic &amp; Bandwidth Monitor" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Enable real-time network traffic tracking, bandwidth meter, and packet inspector" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkTrafficMonitor" AutomationProperties.Name="Network Traffic &amp; Bandwidth Monitor" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="Enable real-time network traffic tracking, bandwidth meter, and packet inspector." />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource CloudSync}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource CloudSyncDesc}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkCloudSync" AutomationProperties.Name="{DynamicResource CloudSync}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource CloudSyncDesc}" />
                        </Grid>

                        <!-- Group 3: Player Wipe Tracker -->
                        <Border Style="{StaticResource SettingsRowDivider}" Margin="0,14,0,10" />
                        <ui:TextBlock Text="Player Wipe Tracker" Style="{StaticResource SettingsSubheader}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Player Wipe Tracker" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Tracks only visible team snapshots while RustPlus Desktop is connected" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkPlayerWipeTracker" AutomationProperties.Name="Player Wipe Tracker" VerticalAlignment="Center" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Tracks only visible team snapshots while RustPlus Desktop is connected." />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Player Wipe Tracker Cloud Backup" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Uploads compact daily tracker documents only after you enable this setting" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkPlayerWipeCloud" AutomationProperties.Name="Player Wipe Tracker cloud backup" VerticalAlignment="Center" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Uploads compact daily tracker documents only after you enable this setting." />
                        </Grid>

                        <!-- Group 4: Diagnostics -->
                        <Border Style="{StaticResource SettingsRowDivider}" Margin="0,14,0,10" />
                        <ui:TextBlock Text="Diagnostics" Style="{StaticResource SettingsSubheader}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="Crash &amp; Freeze Diagnostics" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Opens the directory where crash reports, freeze logs, and diagnostics are saved" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="BtnOpenCrashLogs"
                                       Content="Open Logs"
                                       Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                       Click="BtnOpenCrashLogs_Click"
                                       Appearance="Secondary"
                                       VerticalAlignment="Center"
                                       Height="32"
                                       ToolTip="Opens the directory where crash reports, freeze logs, and diagnostics are saved." />
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Server Events Section -->
                <StackPanel x:Name="SectionServerEvents">
                <ui:TextBlock Text="{DynamicResource ServerEventsSection}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource ListenForServerEvents}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource ListenForServerEventsDesc}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkListenForServerEvents" AutomationProperties.Name="{DynamicResource ListenForServerEvents}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource TrustOwnDetections}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource TrustOwnDetectionsDesc}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkTrustOwnDetections" AutomationProperties.Name="{DynamicResource TrustOwnDetections}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Offline Death Section -->
                <StackPanel x:Name="SectionOfflineDeath">
                <TextBlock Text="{DynamicResource OfflineDeathNotifications}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Enable Offline Death alerts -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource EnableOfflineDeathAlerts}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Play alerts when killed by a player or hazard while offline" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkOfflineDeathAlerts" AutomationProperties.Name="{DynamicResource EnableOfflineDeathAlerts}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Custom sound selector -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource AlertSound}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock x:Name="TxtOfflineDeathSoundPath" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnSelectOfflineDeathSound" Content="{DynamicResource SelectEllipsis}" Icon="{ui:SymbolIcon Symbol=Folder24}" Height="30" Click="BtnSelectOfflineDeathSound_Click" />
                                <ui:Button x:Name="BtnResetOfflineDeathSound" Content="{DynamicResource Reset}" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" Margin="8,0,0,0" Height="30" Appearance="Secondary" Click="BtnResetOfflineDeathSound_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Loop Alert Sound toggle -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource LoopAlertSound}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Repeat the alert audio continuously until dismissed" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkOfflineDeathSoundLoop" AutomationProperties.Name="{DynamicResource LoopAlertSound}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Discord advanced bot toggle (Supporter only) -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource SendToDiscordRaidAlerts}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Send real-time offline death events directly to your Discord bot" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkOfflineDeathDiscord" AutomationProperties.Name="{DynamicResource SendToDiscordRaidAlerts}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" Margin="0,12,0,12" />

                        <!-- Button to open offline deaths log popup -->
                        <ui:Button x:Name="BtnOpenOfflineDeathsLog" Content="{DynamicResource OpenOfflineDeathsLog}" Icon="{ui:SymbolIcon Symbol=List24}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Click="BtnOpenOfflineDeathsLog_Click" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Notification Center Section -->
                <StackPanel x:Name="SectionNotifications">
                <TextBlock Text="{DynamicResource NotificationCenterSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Enable Toast Notifications -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource ShowToastNotifications}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Show pop-up notification banners in the corner of your screen" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkNotificationsToast" AutomationProperties.Name="{DynamicResource ShowToastNotifications}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Enable Notification Sounds -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource PlaySoundAlerts}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Play notification chime when new messages or alerts arrive" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkNotificationsSounds" AutomationProperties.Name="{DynamicResource PlaySoundAlerts}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Notification Retention Period -->
                        <Grid MinHeight="36" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource NotificationRetentionPeriod}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Number of days to store notification history before purging" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="SliderNotificationsRetention" Minimum="1" Maximum="90" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtRetentionDays" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Medium" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" Margin="0,12,0,10" />

                        <!-- Muted Servers -->
                        <ui:TextBlock Text="{DynamicResource MutedServers}" Style="{StaticResource SettingsSubheader}" Margin="0,0,0,6" />
                        <ui:Card MinHeight="60" MaxHeight="120" Padding="8,6" Background="{DynamicResource Surface}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlMutedServers" Margin="6" />
                            </ScrollViewer>
                        </ui:Card>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Map Performance Section -->
                <StackPanel x:Name="SectionMapPerformance" tutorials:Tutorial.TargetId="Settings.Map">
                <TextBlock Text="{DynamicResource UiMapPerformanceQuality}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Image Scaling Quality Dropdown -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource UiImageScalingQuality}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource UiControlsMapImageScalingFilteringMode}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbMapScalingMode" Width="180" Height="32" SelectionChanged="OnSettingChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource UiHighQualityBicubic}" Tag="0" />
                                <ComboBoxItem Content="{DynamicResource UiBalancedLinear}" Tag="1" />
                                <ComboBoxItem Content="{DynamicResource UiPerformanceNearestNeighbor}" Tag="2" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- GPU Caching Toggle -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource UiEnableGPUBitmapCaching}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource UiCachesMapRenderingOnTheGPUExtremelyImprovesPanningAndZoomingSmoothness}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkMapUseCacheMode" AutomationProperties.Name="{DynamicResource UiEnableGPUBitmapCaching}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource UiCachesMapRenderingOnTheGPUExtremelyImprovesPanningAndZoomingSmoothness}" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- GPU Rendering Scale Dropdown -->
                        <Grid MinHeight="36" x:Name="GridMapRenderScale" IsEnabled="{Binding IsChecked, ElementName=ChkMapUseCacheMode}" Margin="16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource UiGPURenderingScale}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource UiResolutionScaleOfTheCachedGPUBitmapLowerScalesImprovePerfo767E03E084}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbMapRenderScale" Width="180" Height="32" SelectionChanged="OnSettingChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource UiText50Fastest}" Tag="0.5" />
                                <ComboBoxItem Content="{DynamicResource UiText75Performance}" Tag="0.75" />
                                <ComboBoxItem Content="{DynamicResource UiText100Native}" Tag="1.0" />
                                <ComboBoxItem Content="{DynamicResource UiText125Sharp}" Tag="1.25" />
                                <ComboBoxItem Content="{DynamicResource UiText150HighResolution}" Tag="1.5" />
                                <ComboBoxItem Content="{DynamicResource UiText200UltraHighResolution}" Tag="2.0" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Aliased Edge Mode Toggle -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource UiDisableGridAntiAliasingAliasedEdgeMode}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource UiDisablesAntiAliasingOnGridLinesAndMarkersImprovesRenderingC0D2589FE1}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkMapUseAliasedEdgeMode" AutomationProperties.Name="{DynamicResource UiDisableGridAntiAliasingAliasedEdgeMode}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource UiDisablesAntiAliasingOnGridLinesAndMarkersImprovesRenderingC0D2589FE1}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Custom HD Map Image Card -->
                <ui:TextBlock Text="{DynamicResource UiCustomHDMapImage}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ui:TextBlock Text="Use a custom high-definition map image from a URL source instead of the map coming from the server. Cached locally and automatically wiped when a server wipe is detected." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,0,12" />

                        <ui:TextBlock Text="Custom Map Image URL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtCustomMapUrl" Height="34" Padding="8,4" PlaceholderText="https://example.com/rust_map_hd.png" VerticalContentAlignment="Center" TextChanged="TxtCustomMapUrl_TextChanged" />
                            <ui:Button Grid.Column="1" x:Name="BtnApplyCustomMapUrl" Content="Apply" Appearance="Primary" Height="34" Margin="8,0,0,0" Click="BtnApplyCustomMapUrl_Click" />
                            <ui:Button Grid.Column="2" x:Name="BtnClearCustomMapUrl" Content="Clear" Appearance="Secondary" Height="34" Margin="8,0,0,0" Click="BtnClearCustomMapUrl_Click" />

                        </Grid>
                        <ui:TextBlock x:Name="TxtCustomMapStatus" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Team Markers Section -->
                <StackPanel x:Name="SectionTeamMarkers">
                <TextBlock Text="{DynamicResource TeamMarkersSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Profile Markers -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <Ellipse Width="38" Height="38" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource Profile}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Show circular team member markers on the map" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowProfileMarkers" AutomationProperties.Name="{DynamicResource Profile}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Player Direction Arrows -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <Path Data="M 20,4 L 32,32 L 8,32 Z" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource PlayerDirectionArrow}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Show direction cone pointing where players are facing" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowPlayerArrows" AutomationProperties.Name="{DynamicResource PlayerDirectionArrow}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Death Markers -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="16" Height="20" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="56">
                                        <Path Data="M20,0 C31,0 40,9 40,20 C40,33 20,56 20,56 C20,56 0,33 0,20 C0,9 9,0 20,0 Z" Fill="IndianRed" Stroke="Black" StrokeThickness="2" Stretch="Fill" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource Death}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Display tombstone markers at death locations" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowDeathMarkers" AutomationProperties.Name="{DynamicResource Death}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Streamer Mode -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource StreamerMode}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Hide player names on the map overlay" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkStreamerModeMarkers" AutomationProperties.Name="{DynamicResource StreamerMode}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Player Icon Scale -->
                        <Grid MinHeight="36" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource ScaleLabel}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Adjust size of marker icons on the map" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="SliderPlayerIconScaleOverlay" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnMarkerSettingChanged" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:TextBlock Text="{Binding Value, ElementName=SliderPlayerIconScaleOverlay, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Medium" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- 3D Map Section -->
                <StackPanel x:Name="SectionThreeDMap">
                <TextBlock Text="{DynamicResource ThreeDMapSectionTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Delete 3D Map Data / Manually Parse Map buttons -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Appearance="Danger" HorizontalAlignment="Stretch" Height="34" Margin="0,0,4,0" Click="BtnDelete3DMapData_Click" Icon="{ui:SymbolIcon Symbol=Delete24}" Content="{DynamicResource Settings3dMapDeleteData}" ToolTip="{DynamicResource Delete3DMapDataTooltip}"/>
                            <ui:Button x:Name="BtnManuallyParseMap" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Margin="4,0,0,0" Grid.Column="1" Click="BtnManuallyParseMap_Click" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="{DynamicResource UiParse3DMapManually}" />
                        </Grid>
                        <ui:TextBlock Text="{DynamicResource SupporterDescription}" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontStyle="Italic" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <!-- Offline Alarms Sync -->
                        <ui:CardExpander Header="Home Assistant" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}" ContentPadding="12,8">
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="Control your Rust smart switches from Home Assistant using a REST switch. Generate an API token, then add the generated snippet to your configuration.yaml." Foreground="{DynamicResource TextSubtle}" FontSize="11" TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Click="BtnHomeAssistantHelp_Click" Appearance="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" ToolTip="Home Assistant setup info" VerticalAlignment="Top" />
                                </Grid>

                                <TextBlock x:Name="TxtHaStatusNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Padding="8,6" Margin="0,0,0,10" Background="#3A2A15" Foreground="#F0B75E" />

                                <ui:TextBlock Text="API Token" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button x:Name="BtnGenerateHaToken" Content="Generate Token" Icon="{ui:SymbolIcon Symbol=Key24}" HorizontalAlignment="Stretch" Height="36" Click="BtnGenerateHaToken_Click" />
                                    <ui:Button x:Name="BtnCopyHaToken" Grid.Column="1" Content="Copy" Icon="{ui:SymbolIcon Symbol=Copy24}" Height="36" Margin="8,0,0,0" IsEnabled="False" Click="BtnCopyHaToken_Click" />
                                </Grid>
                                <ui:TextBox x:Name="TxtHaToken" IsReadOnly="True" Height="28" Padding="6,4" Margin="0,0,0,16" FontFamily="Consolas" PlaceholderText="No token generated yet" />

                                <ui:TextBlock Text="Example configuration.yaml" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                                <ui:TextBlock Text="Replace ENTITYID with the numeric Entity ID shown next to the switch in your device list. Commands apply to whichever server the app is connected to." Foreground="{DynamicResource TextSubtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtHaSnippet" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="180" Padding="6,4" Margin="0,0,0,8" FontFamily="Consolas" FontSize="11" />
                                <ui:Button x:Name="BtnCopyHaSnippet" Content="Copy Snippet" Icon="{ui:SymbolIcon Symbol=Copy24}" HorizontalAlignment="Stretch" Height="32" Margin="0,0,0,16" Click="BtnCopyHaSnippet_Click" />

                                <ui:Button x:Name="BtnRevokeHa" Content="Revoke Token" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Secondary" Foreground="#FF5555" HorizontalAlignment="Stretch" Height="36" Click="BtnRevokeHa_Click" />
                            </StackPanel>
                        </ui:CardExpander>

                        <!--
                            The same two flags as under General. The tracker is a connected service
                            in every practical sense, and someone reviewing what this app sends
                            outward looks here, not under Behaviour. Both copies write the one
                            setting; OnPlayerWipeTrackerToggled keeps them showing the same thing.
                        -->
                        <ui:ToggleSwitch x:Name="ChkPlayerWipeTrackerConnected" Content="Player Wipe Tracker" Margin="0,0,0,10" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Tracks only visible team snapshots while RustPlus Desktop is connected." />
                        <ui:ToggleSwitch x:Name="ChkPlayerWipeCloudConnected" Content="Player Wipe Tracker cloud backup" Margin="0,0,0,10" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Uploads compact daily tracker documents only after you enable this setting." />
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Discord Settings Section -->
                <StackPanel x:Name="SectionDiscord" tutorials:Tutorial.TargetId="Settings.Discord">
                <TextBlock Text="{DynamicResource UiDiscordSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>

                <!-- Invite Bot Button -->
                <ui:Button x:Name="BtnDiscordConnect"
                           HorizontalAlignment="Stretch"
                           Height="36"
                           Margin="0,0,0,6"
                           Click="BtnDiscordConnect_Click">
                    <ui:Button.Icon>
                        <ui:ImageIcon Source="pack://application:,,,/Assets/icons/discord.png"/>
                    </ui:Button.Icon>
                    <TextBlock Text="{DynamicResource UiInviteBotToDiscordServer}"/>
                </ui:Button>

                <!-- Connection Status -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Ellipse x:Name="DotBotStatus"
                             Width="8" Height="8"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="#888888"/>
                    <TextBlock x:Name="TxtAuthStatus"
                               FontSize="11"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{DynamicResource UiDiscordNotConnectedStatus}"/>
                </StackPanel>

                <!-- Channel Notifications -->
                <Border x:Name="BrdSupporterSettings" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Expander Header="{DynamicResource UiDiscordIntegrations}" Margin="-4,0,0,10" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextPrimary}" Padding="0">
                            <StackPanel Margin="0,8,0,0">

                                <!-- Raid -->
                                <TextBlock Text="{DynamicResource UiRaidAlerts}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtChannelRaid" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="—" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="ChkRaidTTS"    Grid.Column="1" Content="{DynamicResource UiTTS}"   Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                    <CheckBox x:Name="ChkRaidAudio"  Grid.Column="2" Content="{DynamicResource UiSound}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                </Grid>

                                <!-- Events -->
                                <TextBlock Text="{DynamicResource UiEventsLabel}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtChannelEvents" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="—" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="ChkEventsTTS"   Grid.Column="1" Content="{DynamicResource UiTTS}"   Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                    <CheckBox x:Name="ChkEventsAudio" Grid.Column="2" Content="{DynamicResource UiSound}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                </Grid>

                                <!-- Team Chat -->
                                <TextBlock Text="{DynamicResource TeamChat}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtChannelChat" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="—" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="ChkChatTTS"   Grid.Column="1" Content="{DynamicResource UiTTS}"   Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                    <CheckBox x:Name="ChkChatAudio" Grid.Column="2" Content="{DynamicResource UiSound}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                </Grid>

                                <!--  Shop — disabled on servers that no longer deliver vending data,
                                      so it is visibly dead rather than silently unused.  -->
                                <TextBlock x:Name="ShopChannelLabel" Text="{DynamicResource ShopWord}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,4,0,2" />
                                <Grid x:Name="ShopChannelRow" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtChannelShop" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="—" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="ChkShopTTS"   Grid.Column="1" Content="{DynamicResource UiTTS}"   Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                    <CheckBox x:Name="ChkShopAudio" Grid.Column="2" Content="{DynamicResource UiSound}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                </Grid>

                                <!-- Trackers -->
                                <TextBlock Text="{DynamicResource UiTrackers}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtChannelTrackers" Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="—" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="ChkTrackersTTS"   Grid.Column="1" Content="{DynamicResource UiTTS}"   Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                    <CheckBox x:Name="ChkTrackersAudio" Grid.Column="2" Content="{DynamicResource UiSound}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource DotCheckBox}" Checked="OnChannelSettingChanged" Unchecked="OnChannelSettingChanged"/>
                                </Grid>



                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Chat Commands Section -->
                <StackPanel x:Name="SectionChatCommands" tutorials:Tutorial.TargetId="Settings.ChatCommands">
                <TextBlock Text="{DynamicResource ChatCommandsSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <views:ChatCommandsOverlay x:Name="ChatCommandsEditor" />
                </StackPanel>

                <!-- Chat Alert Templates Section -->
                <StackPanel x:Name="SectionChatAlertTemplates">
                <TextBlock Text="{DynamicResource CustomAlertsHeader}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <windows:CustomAlertsEditor />
                </StackPanel>

                <!-- BattleMetrics Section -->
                <StackPanel x:Name="SectionBattleMetrics">
                <TextBlock Text="{DynamicResource UiBattleMetrics}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiBattleMetricsApiKeyWarning}"
                                   Foreground="{DynamicResource TextSubtle}"
                                   FontSize="11"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource UiApiKey}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtBattleMetricsApiKey"
                                     Height="30"
                                     PasswordChanged="TxtBattleMetricsApiKey_PasswordChanged"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Maintenance Section -->
                <StackPanel x:Name="SectionMaintenance" tutorials:Tutorial.TargetId="Settings.Maintenance">
                <TextBlock Text="{DynamicResource MaintenanceTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource MaintenanceDesc}"
                                   Foreground="{DynamicResource TextSubtle}"
                                   FontSize="11"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"/>

                        <ui:Button x:Name="BtnShowResetDialog"
                                   Content="{DynamicResource ResetAppData}"
                                   Appearance="Caution"
                                   Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                   HorizontalAlignment="Stretch"
                                   Height="36"
                                   Margin="0,0,0,8"
                                   Click="BtnShowResetDialog_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnBackupData"
                                       Grid.Column="0"
                                       Content="{DynamicResource BackupData}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Symbol=ArrowUpload24}"
                                       HorizontalAlignment="Stretch"
                                       Height="36"
                                       Margin="0,0,4,0"
                                       Click="BtnBackupData_Click"/>
                            <ui:Button x:Name="BtnRestoreData"
                                       Grid.Column="1"
                                       Content="{DynamicResource RestoreData}"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                       HorizontalAlignment="Stretch"
                                       Height="36"
                                       Margin="4,0,0,0"
                                       Click="BtnRestoreData_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Credits Section -->
                <StackPanel x:Name="SectionCredits">
                <TextBlock Text="{DynamicResource CreditsTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <!-- rustmaps.com credit -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="15" Margin="0,0,8,0"
                                          Foreground="#E05070" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                <Run Text="{DynamicResource CreditsIconsPrefix}" Foreground="{DynamicResource TextSubtle}"/>
                                <Hyperlink NavigateUri="https://rustmaps.com" RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{DynamicResource Accent}">
                                    <Run Text="rustmaps.com"/>
                                </Hyperlink>
                                <Run Text="{DynamicResource CreditsIconsSuffix}" Foreground="{DynamicResource TextSubtle}"/>
                            </TextBlock>
                        </StackPanel>
                        <!-- legal note -->
                        <TextBlock Text="{DynamicResource CreditsIconsNote}"
                                   Foreground="{DynamicResource TextSubtle}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
